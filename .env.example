# Runtime
NODE_ENV="development"
PORT="8080"
APP_URL="http://localhost:3000"
API_URL="http://localhost:8080"

# Security
# Use a long random value in every non-local environment.
JWT_SECRET="replace-with-at-least-32-random-characters"
SESSION_TTL_SECONDS="3600"
PASSWORD_PEPPER="replace-with-a-private-password-pepper"

# Database
# Production should use PostgreSQL with TLS and least-privilege credentials.
DATABASE_URL="postgres://boutinly:boutinly@localhost:5432/boutinly_crm"
DATABASE_SSL="false"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Local bootstrap only. Disable in production.
DEMO_LOGIN_ENABLED="true"
DEMO_PASSWORD="ChangeMe123!"

# Email (provider: console | smtp | ses)
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@boutinly.com"
EMAIL_FROM_NAME="Boutinly CRM"

# SMTP settings (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# SES settings (required when EMAIL_PROVIDER=ses)
# AWS_SES_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# File storage (provider: local | s3)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# SSO / OIDC (Google Workspace & Microsoft Entra ID)
# OIDC_GOOGLE_CLIENT_ID=""
# OIDC_GOOGLE_CLIENT_SECRET=""
# OIDC_MICROSOFT_CLIENT_ID=""
# OIDC_MICROSOFT_CLIENT_SECRET=""

# Calendar sync OAuth (Google & Microsoft)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# Frontend
VITE_API_URL="http://localhost:8080"
